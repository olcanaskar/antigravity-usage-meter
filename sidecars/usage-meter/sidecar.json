{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Usage Meter",
  "description": "Shows live context-window token usage and weekly usage limits for the active conversation.",
  "env": {
    "USAGE_METER_HEADER": "1"
  },
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Usage Meter",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Usage Meter"
      }
    ]
  }
}
